# Copy values into environment variables before running the backend:
#   export DB_URL=jdbc:mysql://localhost:3306/LogMasterVehicledb
#   export DB_USERNAME=your_mysql_user
#   export DB_PASSWORD=your_mysql_password
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/LogMasterVehicledb}
spring.datasource.username=${DB_USERNAME:your_mysql_user}
spring.datasource.password=${DB_PASSWORD:your_mysql_password}
